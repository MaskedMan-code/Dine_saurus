# Copy this file to .env.local (preferred, gitignored) or .env and fill in your project values.
# Find these in Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-project-public-anon-key
# Alternatively remove the anon variable and use a public publishable key:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Never use a secret/service-role key or database password in VITE_ variables.

# Geoapify address autocomplete (free tier)
VITE_GEOAPIFY_API_KEY=

# Development-only diagnostics; never log order tokens or diner details.
VITE_DEBUG_LIFECYCLE=false
